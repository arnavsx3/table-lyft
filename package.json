{
  "name": "table-lyft",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, on-click web table capture and clean CSV, spreadsheet, and Markdown exports.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "npm run build && playwright test",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
