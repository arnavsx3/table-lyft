{
  "name": "wingman",
  "version": "1.0.0",
  "description": "Smart cross-browser extension for OmeTV partner filtering and auto-skipping",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.js && wxt",
    "dev:firefox": "node scripts/generate-icons.js && wxt -b firefox",
    "build": "node scripts/generate-icons.js && wxt build",
    "build:firefox": "node scripts/generate-icons.js && wxt -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
