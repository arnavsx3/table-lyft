{
  "name": "wingman",
  "version": "1.1.0",
  "description": "Smart cross-browser extension for OmeTV partner filtering and auto-skipping",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-icons.js && wxt",
    "dev:firefox": "node scripts/generate-icons.js && wxt -b firefox --mv3",
    "build": "node scripts/generate-icons.js && wxt build",
    "build:firefox": "node scripts/generate-icons.js && wxt build -b firefox --mv3",
    "zip": "node scripts/generate-icons.js && wxt zip",
    "zip:firefox": "node scripts/generate-icons.js && wxt zip -b firefox --mv3",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:bundles": "node scripts/verify-bundles.js",
    "check": "npm run compile && npm test"
  },
  "dependencies": {
    "@vladmandic/face-api": "^1.7.15",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
